# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/
.python-version

# --- Test / tooling caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
*.log

# --- Environment files (only the template is tracked) ---
.env
.env.local
.env.*.local

# --- Generated data (reproducible from scripts/generate_sample_data.py) ---
data/**/*.nc
data/**/*.manifest.json
data/**/*.csv
data/**/*.parquet
data/processed/events.json
data/processed/tracks.json
# Phase 6: ingested real/historical data. The .nc files are already covered
# above; these are the per-dataset artefacts that would otherwise be committed
# with machine-specific absolute paths and retrieval timestamps.
data/manifests/*.json
data/cache/
# Optional ground-truth / event reference datasets (potentially large, and
# never part of this repository's own code).
data/reference/*.json
# Phase 6 real-data evaluation output (regenerate with
# scripts/evaluate_real_data.py).
reports/
data/processed/real_*.json
data/processed/era5_*.json
# Phase 4 downscaling dataset (regenerate with scripts/build_downscaling_dataset.py).
data/processed/downscaling/
data/processed/*.png
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.onnx
# Phase 3 GNN checkpoint (regenerate with scripts/train_gnn.py).
models/gnn/*.json
# Phase 4 AI downscaling checkpoint (regenerate with scripts/train_downscaling.py).
models/downscaling/*.pt

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/

# Phase 7: the real-data validation workspace. Reports and provenance records
# contain machine-specific paths and run timestamps, so they are regenerated
# by scripts/run_phase7_validation.py rather than committed.
data/validation/

# Phase 8: near-real-time run records and incremental state. These are runtime
# state, regenerated by the pipeline, not source. See docs/REALTIME_PIPELINE.md.
data/realtime/

# Phase 9: evaluation runs are reproducible from the recorded seed, dataset
# checksum and code fingerprint, so they are runtime state rather than source.
data/evaluation/

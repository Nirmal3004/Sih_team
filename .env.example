# DeepWeather AI - SIH26078
# Example environment file. Copy to `.env` and adjust as needed.
# There are NO secrets here and none are required: all Phase 0 data is
# synthetic and generated locally (no external weather API keys).

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Paths (relative to the repository root; no machine-specific paths) ---
DATA_DIR=data
MODEL_DIR=models
RAW_DATA_SUBDIR=raw
PROCESSED_DATA_SUBDIR=processed
SAMPLES_DATA_SUBDIR=samples

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Synthetic data generator (deterministic, seed controlled) ---
SYNTHETIC_SEED=20260601
SYNTHETIC_TIME_STEPS=72
SYNTHETIC_START_TIME=2024-06-01T00:00:00
SYNTHETIC_TIME_STEP_HOURS=1
SYNTHETIC_GRID_RESOLUTION_DEG=0.125
SYNTHETIC_LATITUDE_MIN=10.0
SYNTHETIC_LATITUDE_MAX=16.0
SYNTHETIC_LONGITUDE_MIN=74.0
SYNTHETIC_LONGITUDE_MAX=80.0
SYNTHETIC_EVENT_ENABLED=true
SYNTHETIC_EVENT_PEAK_MM_PER_HOUR=55.0

# --- Reference resolutions for the future 12 km -> 5 km downscaling work ---
NWP_NATIVE_RESOLUTION_DEG=0.125
DOWNSAMPLE_TARGET_RESOLUTION_DEG=0.05

# --- Anomaly detection (Phase 1) ---
# Default output file of scripts/detect_anomalies.py, relative to DATA_DIR.
EVENTS_FILENAME=events.json
# Default anomaly score: absolute | standardized | percentile | extremeness | efi
ANOMALY_DEFAULT_SCORE=absolute
# Default climatology grouping: month | day_of_year | all
ANOMALY_DEFAULT_GROUPING=month

# --- Event tracking (Phase 2) ---
# Default output file of scripts/track_events.py, relative to DATA_DIR.
TRACKS_FILENAME=tracks.json
# The event-matching gates (max distance / speed / time gap, and the distance and
# intensity cost weights) are NOT environment settings: they belong to the
# validated `MatchingConfig` model and are passed in code or on the CLI, e.g.
#   python scripts/track_events.py --max-distance-km 150 --max-speed-kmh 80
# Defaults: 250 km, 120 km/h, 6 h, weights 0.7 distance / 0.3 intensity.

# --- Alerting and emergency response (Phase 5) ---
# The alert file the CLI writes and the API reads, relative to
# <DATA_DIR>/processed.
ALERTS_FILENAME=alerts.json
# Append-only LOCAL log of the notifications that were produced. Nothing is
# delivered to any external service; see extreme_weather.alerts.notifications.
NOTIFICATIONS_FILENAME=notifications.json
# Master switch for alert generation. When false the API still serves whatever
# is already stored, but POST /api/v1/alerts/generate returns HTTP 503 instead
# of silently doing nothing.
ALERT_GENERATION_ENABLED=true
# How long a freshly created alert is considered current, in minutes.
ALERT_DEFAULT_VALIDITY_MINUTES=360
# Time bucket used for alert deduplication, in minutes. Re-running the generator
# inside this window UPDATES an existing alert instead of creating a duplicate.
ALERT_DEDUPLICATION_WINDOW_MINUTES=60
#
# There are NO environment settings for the risk weights, the reference values,
# the severity cut points or the rule thresholds: those are validated
# `RiskConfig` / `SeverityThresholds` / `RuleConfig` dataclasses passed in code
# (see extreme_weather.alerts). Env vars for them would be configuration that is
# never read, so none were invented.
#
# FUTURE optional integrations (NOT implemented, NOT required, and deliberately
# left blank - there are no secrets in this file). The email and webhook adapters
# are stubs that read no credential and send nothing; enabling a real channel
# would be an explicit future change:
#   ALERT_EMAIL_SMTP_HOST=
#   ALERT_EMAIL_SMTP_PORT=
#   ALERT_EMAIL_FROM=
#   ALERT_WEBHOOK_URL=
#
# The alert severities are PROJECT PROTOTYPE CATEGORIES, not official IMD or
# WMO warnings, and the pipeline runs on synthetic data. It is not an
# operational warning system and must not be used for emergency decisions.
# --- GNN event evolution (Phase 3, prototype) ---
# There are no environment settings for the model: the architecture, the matching
# and the feature scaling are validated dataclasses, configured in code or on the
# CLI, e.g.
#   python scripts/train_gnn.py --epochs 500 --learning-rate 0.02 --seed 7
#   python scripts/build_graph_dataset.py --no-spatial-edges
# The checkpoint location follows MODEL_DIR: <MODEL_DIR>/gnn/best.json
#
# NOTE: the model is a research prototype trained on synthetic data. It is not an
# operational forecast and must not be used for emergency decisions.

# --- AI downscaling (Phase 4, prototype) ---
# The target resolution comes from DOWNSAMPLE_TARGET_RESOLUTION_DEG above and is
# otherwise detected from the data. There are no environment settings for the
# model itself: the architecture, the feature scaling and the training options
# are validated dataclasses passed in code or on the CLI, e.g.
#   python scripts/train_downscaling.py --epochs 40 --learning-rate 0.001
# The checkpoint location follows MODEL_DIR: <MODEL_DIR>/downscaling/best.pt
#
# NOTE: the high-resolution training target is SYNTHETIC, generated from the
# coarse field. It is not observational truth, and the metrics against it are
# not real-world forecast skill. Higher resolution does not imply accuracy.

# --- Real / historical data ingestion (Phase 6) ------------------------------
# These are documented placeholders. None of them is a real secret and none is
# required for local-file ingestion.
#
# The ERA5 source (Open-Meteo archive) requires NO credentials. The variable
# below only raises the rate limit; leave it unset unless you hit the limit.
#   OPEN_METEO_API_KEY=
#
# The NWP source reads a remote endpoint only when one is configured. The
# token is optional and is used solely for endpoints that require a bearer
# token; it is never logged and never returned through the API.
#   NWP_API_URL=https://example.invalid/nwp
#   NWP_API_TOKEN=
#
# No key was committed to this repository, and none is required to reproduce the
# documented workflow.

# Sub-directory of DATA_DIR/raw for REAL ingested data. Synthetic data stays in
# <raw_dir>/synthetic; the two are never mixed.
# REAL_DATA_SUBDIR=real
# SYNTHETIC_DATA_SUBDIR=synthetic
# Manifest directory, one JSON per ingested dataset.
# MANIFESTS_SUBDIR=manifests
# Optional ground-truth / event reference datasets.
# REFERENCE_SUBDIR=reference
# Suffix appended to a processed real dataset.
# PROCESSED_REAL_SUFFIX=_processed.nc
# Where a remote source caches what it downloads.
# CACHE_SUBDIR=cache
# Hard ceiling on a single download, in MB. A regional ERA5 subset is a few MB;
# a global field is tens of GB.
# MAX_DOWNLOAD_MB=512
# Variables kept when an ingestion request asks for no subset.
# INGESTION_DEFAULT_VARIABLES=precipitation,temperature,pressure,relative_humidity,u_wind,v_wind
# Optional spatial subset, as "min,max". Empty means the whole source grid.
# INGESTION_LATITUDE_BOUNDS=
# INGESTION_LONGITUDE_BOUNDS=

# ---------------------------------------------------------------------------
# Phase 8 - near-real-time pipeline
# ---------------------------------------------------------------------------
# Run records and incremental state are written under <DATA_DIR>/realtime/runs.
# No separate setting is needed: they follow DATA_DIR so a container volume
# picks them up automatically.
#
# Optional bearer token for the `remote-http` weather provider. It is sent as an
# Authorization header, never as a query parameter, and is redacted from logs,
# manifests and API responses. Never commit a real token.
# WEATHER_API_TOKEN=
#
# Secondary variable name also accepted for provider tokens.
# OPEN_METEO_API_KEY=
#
# Freshness windows are per-deployment policy rather than application identity,
# so they are CLI/API arguments (--fresh-hours, --stale-hours) rather than
# environment settings. Defaults: fresh 3 h, stale 12 h.

# ---------------------------------------------------------------------------
# Phase 9 - model evaluation
# ---------------------------------------------------------------------------
# Evaluation runs are written to <DATA_DIR>/evaluation/runs and follow DATA_DIR,
# so a container volume picks them up with no extra setting.
#
# Reproducibility is carried inside each run record, not in the environment: the
# bootstrap seed, the dataset checksum, the split boundaries, the model
# checkpoint, and a SHA-256 fingerprint of the evaluation source files. Running
# the same evaluation twice with the same inputs produces identical records.
#
# No new environment variable is required for Phase 9.

# ---------------------------------------------------------------------------
# Phase 10 - production hardening, observability and deployment
# ---------------------------------------------------------------------------
# Every value below has a safe default for local development, so a fresh
# checkout runs with none of these set. They exist so a deployment can be
# configured without editing code.
#
# --- logging ---------------------------------------------------------------
# Threshold: DEBUG, INFO, WARNING or ERROR. An unrecognised value falls back to
# INFO rather than failing a container at start-up.
# LOG_LEVEL=INFO
# Rendering: 'text' for a terminal, 'json' for a log shipper (one object/line).
# LOG_FORMAT=text

# --- deployment identity ---------------------------------------------------
# Set to 'production' in a deployment. Drives production-aware defaults; it does
# not by itself make the system operational.
# APP_ENV=development

# --- security switches -----------------------------------------------------
# Refuse any caller-supplied path that resolves outside DATA_DIR. Leave on
# outside a deliberately unusual deployment.
# ENFORCE_DATA_DIR_BOUNDARY=true
# Hash model checkpoints and manifests before use, so a corrupt artefact is
# reported rather than loaded.
# VERIFY_ARTIFACT_INTEGRITY=true
# Permit a '*' CORS origin. OFF by default: a wildcard origin lets any website
# read this API from a browser.
# ALLOW_CORS_WILDCARD=false
# Longest error message returned to a client, in characters.
# API_MAX_DETAIL_CHARS=2000
# Header carrying the request correlation id, in and out.
# API_REQUEST_ID_HEADER=X-Request-ID

# --- readiness -------------------------------------------------------------
# Free space below which /ready reports the filesystem as DEGRADED.
# 256 MiB = 268435456 bytes.
# MIN_FREE_DISK_BYTES=268435456

# NOTE: no authentication is implemented. This service is a research prototype
# and must sit behind an authenticating reverse proxy on any untrusted network.
# See docs/SECURITY.md.
